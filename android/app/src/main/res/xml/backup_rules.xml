<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Never back up secrets or the Ubuntu rootfs -->
    <exclude domain="file" path="ubuntu/" />
    <exclude domain="file" path="secrets/" />
    <exclude domain="file" path="runtime/" />
    <exclude domain="file" path="downloads/" />
    <exclude domain="file" path="archives/" />
</full-backup-content>
